# Copy to .env and fill in the keys you need. .env is gitignored.

# OpenRouter: panel runs with --backend openrouter, and the data/compact pipeline.
OPENROUTER_API_KEY=

# Shared secret for the self-hosted vLLM server (--backend vllm). Any random string.
VLLM_API_KEY=

# Hugging Face: downloading the Qwen3 tokenizer and the AuditBench adapters.
HF_TOKEN=

# Lambda Cloud API: scripts/lambda/lambda_cloud.py (launching and terminating GPU instances).
LAMBDA_API_KEY=
